# ============ 后台管理 ============
# 后台登录密码（必须修改！访问 /admin 时使用）
ADMIN_PASSWORD=

# 会话签名密钥（可选，建议设置一串随机字符；不设置则复用上面的密码）
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# ============ 线上文章存储（GitHub 模式）============
# 在 Vercel 上必须配置这两项，后台保存的文章/图片才会提交到 GitHub 并触发重新部署。
# 本地开发可不配置（自动使用本地文件模式）。
#
# GITHUB_TOKEN：GitHub 个人访问令牌（Fine-grained PAT）
#   创建地址：https://github.com/settings/personal-access-tokens/new
#   权限：Repository permissions → Contents → Read and write
#   资源：只授权你的网站仓库
# GITHUB_REPO：仓库名，格式 owner/repo（如 YZWEB3/crypto-zen）
GITHUB_TOKEN=
GITHUB_REPO=
